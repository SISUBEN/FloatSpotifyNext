<Window x:Class="FloatSpotify.Windows.LyricsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FloatSpotify.Localization"
        xmlns:vm="clr-namespace:FloatSpotify.ViewModels"
        xmlns:local="clr-namespace:FloatSpotify.Windows"
        Title="FloatSpotify Lyrics"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MaxWidth="{x:Static vm:OverlayViewModel.MaximumOverlayWidth}"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="{Binding AlwaysOnTop}">
    <Grid>
        <Border x:Name="LyricSurface"
                Width="{Binding OverlayWidth}"
                MinHeight="48"
                HorizontalAlignment="Center"
                Padding="17,9,17,9"
                CornerRadius="6"
                Cursor="SizeAll"
                PreviewMouseLeftButtonDown="LyricSurface_MouseLeftButtonDown"
                PreviewMouseMove="LyricSurface_MouseMove"
                PreviewMouseLeftButtonUp="LyricSurface_MouseLeftButtonUp"
                LostMouseCapture="LyricSurface_LostMouseCapture">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#01000000" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="BorderBrush" Value="#00000000" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                            <Setter Property="Background" Value="#26000000" />
                            <Setter Property="BorderBrush" Value="#40FFFFFF" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Opacity="{Binding OverlayOpacity}">
                <ScrollViewer x:Name="LyricScroller"
                              HorizontalScrollBarVisibility="Disabled"
                              ToolTip="{loc:Tr Overlay_PlainText_Tooltip}">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="IsHitTestVisible" Value="False" />
                            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LyricFrame.ActiveLyric.IsPlainText}" Value="True">
                                    <Setter Property="IsHitTestVisible" Value="True" />
                                    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                                    <Setter Property="MaxHeight" Value="300" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                <local:KaraokeText Frame="{Binding LyricFrame}"
                           Foreground="{Binding TextColor}"
                           FontFamily="{Binding ResolvedFontFamily}"
                           FontSize="{Binding FontSize}"
                           FontWeight="SemiBold"
                           TextOptions.TextFormattingMode="Display">
                    <local:KaraokeText.Style>
                        <Style TargetType="local:KaraokeText">
                            <Setter Property="Effect" Value="{x:Null}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding GlowEnabled}" Value="True">
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#E6000000"
                                                              BlurRadius="10"
                                                              ShadowDepth="1"
                                                              Opacity="0.9" />
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </local:KaraokeText.Style>
                </local:KaraokeText>
                </ScrollViewer>

                <TextBlock x:Name="NextLyricText"
                           Text="{Binding NextLine}"
                           Margin="0,3,0,0"
                           Foreground="{Binding TextColor}"
                           Opacity="0.32"
                           FontFamily="{Binding ResolvedFontFamily}"
                           FontSize="{Binding FontSize, ConverterCulture=en-US}"
                           FontWeight="Normal"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Visibility="{Binding ShowNextLine, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock.LayoutTransform>
                        <ScaleTransform ScaleX="0.72" ScaleY="0.72" />
                    </TextBlock.LayoutTransform>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
