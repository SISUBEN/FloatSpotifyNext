<Window x:Class="FloatSpotify.Windows.SpotifySetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FloatSpotify.Localization"
        Title="{loc:Tr Setup_Title}"
        Width="500"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FF16191E"
        Foreground="White">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="#FF272C33" />
            <Setter Property="BorderBrush" Value="#50656F78" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Text="{loc:Tr Setup_Title}" />

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Text="{loc:Tr Setup_Step1}" />
            <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Text="{loc:Tr Setup_Step2}" />
            <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Text="{loc:Tr Setup_Step3}" />
            <TextBlock TextWrapping="Wrap" Text="{loc:Tr Setup_Step4}" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Height="34"
                     Padding="9,5"
                     VerticalContentAlignment="Center"
                     IsReadOnly="True"
                     Background="#FF20242A"
                     BorderBrush="#50656F78"
                     Foreground="#FFE7EAED"
                     FontFamily="Consolas"
                     Text="http://127.0.0.1:8888/callback" />
            <Button x:Name="CopyCallbackButton"
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Content="{loc:Tr Setup_CopyCallback}"
                    Click="CopyCallbackButton_Click" />
        </Grid>

        <TextBlock Grid.Row="3"
                   Margin="0,14,0,0"
                   Foreground="#B8FFFFFF"
                   TextWrapping="Wrap"
                   Text="{loc:Tr Setup_SaveNote}" />

        <Border Grid.Row="4" Height="1" Margin="0,18,0,14" Background="#28FFFFFF" />

        <StackPanel Grid.Row="5" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Margin="0,0,8,0"
                    Background="#FF1DB954"
                    BorderBrush="#FF1DB954"
                    Content="{loc:Tr Setup_OpenDashboard}"
                    Click="OpenDashboardButton_Click" />
            <Button Content="{loc:Tr Setup_Close}" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
