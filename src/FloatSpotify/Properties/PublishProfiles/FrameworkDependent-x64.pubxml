<?xml version="1.0" encoding="utf-8"?>
<!--
  框架依赖 · 文件夹形态
  用途：在线安装包的载荷（Setup-Online）。安装包约 10-20 MB，
        安装时由安装程序检测 .NET 8 桌面运行时，缺失才联网下载安装。
  注意：目标机必须存在 Microsoft.WindowsDesktop.App 8.x，否则无法启动。
        体积主要由随包发布的 Microsoft.Windows.SDK.NET.dll（约 21 MB，
        YouTube Music 所需的 WinRT 投影）构成，这部分无法通过框架依赖省掉。
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
